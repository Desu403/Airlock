{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "airlock",
  "version": "0.1.0",
  "identifier": "dev.airlock.viewer",
  "build": {
    "frontendDist": "ui"
  },
  "app": {
    "withGlobalTauri": true,
    "security": {
      "csp": "default-src 'self'; img-src 'self' blob:; style-src 'self'; script-src 'self'; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'none'; form-action 'none'"
    }
  },
  "bundle": {
    "active": false,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/256x256.png",
      "icons/icon.png",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDQyMzIzMEE4RUZCNjJDNzgKUldSNExMYnZxREF5UW1nZnVab29kL1J6dEJ4YjgwRkdsVGZBZmxnTlh6d00zVEc1cU9Tbm5MVHgK",
      "endpoints": [
        "https://github.com/Desu403/Airlock/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
