# airlock guest kernel: applied on top of Firecracker's microvm 6.1 config.
# The guest kernel is the wall between an exploited renderer and the VMM,
# so everything a document renderer does not need is removed.

# --- Attack surface the guest never needs ---------------------------------
# Several of the switches below are only visible with EXPERT.
CONFIG_EXPERT=y
# CONFIG_MODULES is not set
# CONFIG_BPF_SYSCALL is not set
# CONFIG_BPF_JIT is not set
# CONFIG_USER_NS is not set
# CONFIG_IO_URING is not set
# CONFIG_USERFAULTFD is not set
# CONFIG_KEXEC is not set
# CONFIG_KEXEC_FILE is not set
# CONFIG_CRASH_DUMP is not set
# CONFIG_IA32_EMULATION is not set
# CONFIG_X86_X32_ABI is not set
# CONFIG_MODIFY_LDT_SYSCALL is not set
# CONFIG_X86_IOPL_IOPERM is not set
# CONFIG_LEGACY_VSYSCALL_EMULATE is not set
# CONFIG_LEGACY_VSYSCALL_XONLY is not set
CONFIG_LEGACY_VSYSCALL_NONE=y
# CONFIG_BINFMT_MISC is not set
# CONFIG_COMPAT_BRK is not set
# CONFIG_DEVMEM is not set
# CONFIG_DEVPORT is not set
# CONFIG_PROC_KCORE is not set
# CONFIG_HIBERNATION is not set
# CONFIG_MAGIC_SYSRQ is not set
# CONFIG_KPROBES is not set
# CONFIG_UPROBES is not set
# CONFIG_FTRACE is not set
# CONFIG_PERF_EVENTS cannot be disabled on x86 (arch selects it);
# perf_event_open is denied + logged by the renderer's seccomp monitor.
# CONFIG_DEBUG_FS is not set
# CONFIG_CHECKPOINT_RESTORE is not set
# CONFIG_KALLSYMS_ALL is not set
# CONFIG_AUDIT is not set
# CONFIG_SECURITY_SELINUX is not set

# Networking: IPv4 TCP/UDP + AF_UNIX (LibreOffice) + vsock only.
# CONFIG_IPV6 is not set
# CONFIG_PACKET is not set
# CONFIG_NETFILTER is not set
# CONFIG_BRIDGE is not set
# CONFIG_VLAN_8021Q is not set
# CONFIG_NET_SCHED is not set
# CONFIG_XFRM_USER is not set
# CONFIG_NET_KEY is not set
CONFIG_UNIX=y
CONFIG_INET=y
CONFIG_IP_PNP=y
CONFIG_VSOCKETS=y
CONFIG_VIRTIO_VSOCKETS=y

# Filesystems: ext4 (root, scratch), tmpfs, proc/sys/devtmpfs; squashfs kept
# for a future compressed root image.
# CONFIG_NFS_FS is not set
# CONFIG_FUSE_FS is not set
# CONFIG_NET_9P is not set
# CONFIG_ISO9660_FS is not set
# CONFIG_VFAT_FS is not set
# CONFIG_BTRFS_FS is not set
# CONFIG_XFS_FS is not set
CONFIG_EXT4_FS=y
CONFIG_TMPFS=y
CONFIG_DEVTMPFS=y
CONFIG_SQUASHFS=y
CONFIG_SQUASHFS_ZSTD=y

# --- Hardening ---------------------------------------------------------------
CONFIG_SECCOMP=y
CONFIG_SECCOMP_FILTER=y
CONFIG_SECURITY=y
CONFIG_SECURITY_YAMA=y
CONFIG_SECURITY_DMESG_RESTRICT=y
CONFIG_RANDOMIZE_BASE=y
CONFIG_RANDOMIZE_MEMORY=y
CONFIG_RANDOMIZE_KSTACK_OFFSET_DEFAULT=y
CONFIG_STACKPROTECTOR=y
CONFIG_STACKPROTECTOR_STRONG=y
CONFIG_VMAP_STACK=y
CONFIG_STRICT_KERNEL_RWX=y
CONFIG_HARDENED_USERCOPY=y
CONFIG_FORTIFY_SOURCE=y
CONFIG_INIT_ON_ALLOC_DEFAULT_ON=y
CONFIG_INIT_ON_FREE_DEFAULT_ON=y
CONFIG_ZERO_CALL_USED_REGS=y
CONFIG_SLAB_FREELIST_RANDOM=y
CONFIG_SLAB_FREELIST_HARDENED=y
CONFIG_SHUFFLE_PAGE_ALLOCATOR=y
CONFIG_SCHED_STACK_END_CHECK=y
CONFIG_DEBUG_LIST=y
CONFIG_DEBUG_SG=y
CONFIG_DEBUG_NOTIFIERS=y
CONFIG_BUG_ON_DATA_CORRUPTION=y
CONFIG_PAGE_TABLE_ISOLATION=y
CONFIG_RETPOLINE=y
# Usermode helpers (a classic escalation path) all point at nothing.
CONFIG_STATIC_USERMODEHELPER=y
CONFIG_STATIC_USERMODEHELPER_PATH=""
# Any kernel oops = likely exploit attempt: die immediately (host notices).
CONFIG_PANIC_ON_OOPS=y
CONFIG_PANIC_TIMEOUT=-1
