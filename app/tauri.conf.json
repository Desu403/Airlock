{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "airlock",
  "version": "0.1.0",
  "identifier": "dev.airlock.viewer",
  "build": { "frontendDist": "ui" },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      { "title": "airlock", "width": 1280, "height": 860, "minWidth": 720, "minHeight": 480, "dragDropEnabled": true }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' blob:; style-src 'self'; script-src 'self'; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'none'; form-action 'none'"
    }
  },
  "bundle": { "active": false, "icon": ["icons/icon.png"] }
}
